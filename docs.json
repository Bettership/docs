{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bettership help center",
  "colors": {
    "primary": "#4E7E68",
    "light": "#75AD93",
    "dark": "#4E7E68"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#FAF8F3",
      "dark": "#202525"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "search": {
    "prompt": "Search the help center\u2026"
  },
  "navigation": {
    "groups": [
      {
        "group": "Help center",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Start here",
        "pages": [
          "start-here/index",
          "start-here/what-bettership-is",
          "start-here/meet-the-agents",
          "start-here/your-first-week"
        ]
      },
      {
        "group": "How Bettership works",
        "pages": [
          "how-bettership-works/index",
          "how-bettership-works/focus-areas",
          "how-bettership-works/library-and-inbox",
          "how-bettership-works/the-wiki",
          "how-bettership-works/the-practice-loop",
          "how-bettership-works/what-you-keep"
        ]
      },
      {
        "group": "Your Bettership agents",
        "pages": [
          "agents/index",
          "agents/steward",
          "agents/scout",
          "agents/coach",
          "agents/maker"
        ]
      },
      {
        "group": "Bringing things in",
        "pages": [
          "bringing-things-in/index",
          "bringing-things-in/add-a-resource",
          "bringing-things-in/capture-a-session",
          "bringing-things-in/what-happens-after",
          "bringing-things-in/collections"
        ]
      },
      {
        "group": "Practicing and applying",
        "pages": [
          "practicing-and-applying/index"
        ]
      },
      {
        "group": "Your account",
        "pages": [
          "account/index",
          "account/settings",
          "account/your-data-and-privacy"
        ]
      },
      {
        "group": "Troubleshooting",
        "pages": [
          "troubleshooting/index",
          "troubleshooting/install-and-permissions",
          "troubleshooting/getting-help"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Bettership",
        "href": "https://bettership.ai"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy"
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/start-here",
      "permanent": true
    }
  ],
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "Urbanist",
      "weight": 400
    }
  }
}
