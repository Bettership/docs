{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Bettership help center",
  "colors": {
    "primary": "#4E7E68",
    "light": "#75AD93",
    "dark": "#4E7E68"
  },
  "appearance": {
    "default": "light"
  },
  "background": {
    "color": {
      "light": "#FAF8F3",
      "dark": "#202525"
    }
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "search": {
    "prompt": "Search the help center\u2026"
  },
  "navigation": {
    "groups": [
      {
        "group": "Help center",
        "pages": [
          "index"
        ]
      },
      {
        "group": "Explore",
        "pages": [
          "start-here/index",
          "how-bettership-works/index",
          "agents/index",
          "bringing-things-in/index",
          "practicing-and-applying/index",
          "account/index",
          "troubleshooting/index"
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Bettership",
        "href": "https://bettership.ai"
      }
    ]
  },
  "contextual": {
    "options": [
      "copy"
    ]
  },
  "redirects": [
    {
      "source": "/quickstart",
      "destination": "/start-here",
      "permanent": true
    }
  ],
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "Urbanist",
      "weight": 400
    }
  }
}
